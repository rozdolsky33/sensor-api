      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_seconds[10s])))",
          "legendFormat": "p95 latency",
          "refId": "A",
          "range": true
        }
      ]
    },
