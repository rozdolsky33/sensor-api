          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(k6_http_reqs_total{expected_response=\"false\"}[10s])) or vector(0)) / sum(rate(k6_http_reqs_total[10s]))",
          "legendFormat": "Error rate",
          "refId": "A",
          "range": true
        }
